# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv / Python 虚拟环境
.venv/
.uv-cache/

# 本地密钥与环境配置
.env
.env.*
!.env.example

# PyCharm、VS Code 与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# Vue 前端依赖
frontend/node_modules/

# 测试、日志与临时缓存
.pytest_cache/
.ruff_cache/
.runtime-temp/
.coverage
*.log

# 运行输出。保留目录本身，不提交分析报告和临时上传文件
outputs/*
!outputs/.gitkeep

# 外部工业数据集不进入代码仓库
data/raw/
*.csv
*.parquet
*.xlsx
