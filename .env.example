# 复制为 .env 后填写。真实密钥禁止提交到 GitHub。
# 默认使用比赛方提供的联通元景 MaaS OpenAI 兼容接口。
LLM_PROVIDER=yuanjing_maas
LLM_API_KEY=your_competition_api_key
LLM_BASE_URL=https://maas-api.ai-yuanjing.com/openapi/compatible-mode/v1
LLM_CHAT_MODEL=glm-5
LLM_EMBEDDING_MODEL=qwen3-embed-0.6b
LLM_OCR_MODEL=glm-ocr
LLM_VISION_MODEL=YuanjingVL
DOCUMENT_PARSER_URL=https://maas-api.ai-yuanjing.com/openapi/v1/rag/model_parser_file

# 比赛方规定每个接口每分钟最多调用 5 次。建议保留默认值，由程序自动排队。
LLM_REQUESTS_PER_MINUTE=5
EMBEDDING_REQUESTS_PER_MINUTE=5

SKAB_DEFAULT_FILE=../SKAB/data/valve1/0.csv
SKAB_DEFAULT_DIR=../SKAB/data/valve1
HEALTHY_BASELINE_FILE=../SKAB/data/anomaly-free/anomaly-free.csv

# 可版本化的设备字段、单位、基线和推荐参数配置目录。
DEVICE_PROFILES_DIR=resources/device_profiles

# PostgreSQL 是项目唯一业务数据库。密码中的特殊字符需要进行 URL 编码。
DATABASE_URL=postgresql://shichi_qianji_app:请填写数据库密码@127.0.0.1:5432/shichi_qianji
DATABASE_SCHEMA=public
# 仅 Docker/万悟联调需要；容器通过宿主机地址访问 PostgreSQL。
DOCKER_DATABASE_URL=postgresql://shichi_qianji_app:请填写数据库密码@host.docker.internal:5432/shichi_qianji

ANOMALY_DETECTOR=time_frequency_relation
ANOMALY_THRESHOLD=3.5
ROLLING_WINDOW=61
MIN_EVENT_LENGTH=12
MERGE_GAP=30
CONTAMINATION=0.01

# 预测与回测参数
FORECAST_HORIZON=30
FORECAST_LOOKBACK=120
FORECAST_HOLDOUT=30

# 万悟异步分析任务：同时执行 2 个，额外允许 8 个排队。
ASYNC_JOB_WORKERS=2
ASYNC_JOB_QUEUE_SIZE=8

# 自动化编排归属：backend 表示 FastAPI 自行轮询并推送；wanwu 表示由已发布的万悟工作流
# 调用无人值守工具。比赛展示推荐 wanwu，让采集、分析、派单、推送均出现在平台运行记录中。
AUTOMATION_ORCHESTRATOR=wanwu

# 自动化编排归属：backend 表示 FastAPI 自行轮询并推送；wanwu 表示由已发布的万悟工作流
# 调用无人值守工具。比赛展示推荐 wanwu，让采集、分析、派单、推送均出现在平台运行记录中。
AUTOMATION_ORCHESTRATOR=wanwu

# 无人值守监测。开启后，FastAPI 启动时会按数据源各自周期自动轮询并提交分析任务。
# 校赛演示可以先保持 false，在“自动监测”页面配置目录后手动触发一次；确认无误再开启。
AUTOMATIC_MONITOR_ENABLED=false
AUTOMATIC_MONITOR_TICK_SECONDS=1
AUTOMATIC_MONITOR_STORAGE_DIR=outputs/auto_ingestion

# 万悟 JSON 文件适配。Base64 和 URL 下载均限制为 25 MiB。
MAX_UPLOAD_BYTES=26214400
WANWU_DOWNLOAD_TIMEOUT=30

# 默认禁止 URL 下载访问本机和局域网。仅在完全受控的本地万悟联调中临时开启。
WANWU_ALLOW_PRIVATE_FILE_URLS=false

# Ubuntu 服务器中万悟和时察千机共用 Docker 网络时，只放行实际提供临时文件的容器主机名。
# 先查看万悟返回的 file_url，再按实际情况填写；不要填写 127.0.0.1 或整个网段。
WANWU_ALLOWED_FILE_HOSTS=

# 写入 FastAPI OpenAPI 的服务地址。本机 Docker 万悟使用 host.docker.internal；
# 比赛方在线万悟必须改为真实公网 HTTPS 地址。
# 两个项目都使用 Docker 且加入 wanwu-net 时使用容器名；仅在 Windows 运行 API 时改为
# http://host.docker.internal:8000。
API_PUBLIC_BASE_URL=http://shichi-qianji-api:8000

# 可选：为 HTTP 服务设置访问密钥；留空表示本地开发不校验
INDUSTRIAL_API_KEY=
# 生产域名仍需显式填写；本地 localhost/127.0.0.1 的动态 Vite 端口由后端安全正则放行。
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选的本地人员闭环。开启后前端显示登录页；不开放公开注册。
# 至少设置一个复杂的 AUTH_BOOTSTRAP_PASSWORD 后再把 AUTH_ENABLED 改为 true。
AUTH_ENABLED=false
AUTH_SESSION_HOURS=12
AUTH_BOOTSTRAP_PASSWORD=请填写校赛演示账号密码

# 企业微信群机器人主动告警。真实 Webhook 只能写入本地 .env，禁止提交或放到前端表单。
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_TIMEOUT_SECONDS=10

# Docker Compose 宿主机路径。服务器可改为 /data 下的持久化目录。
SHICHI_OUTPUT_DIR=./outputs
SKAB_HOST_DIR=../SKAB
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
