# 复制为 .env 后填写。真实密钥禁止提交到 GitHub。
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus

SKAB_DEFAULT_FILE=../SKAB/data/valve1/0.csv
SKAB_DEFAULT_DIR=../SKAB/data/valve1
HEALTHY_BASELINE_FILE=../SKAB/data/anomaly-free/anomaly-free.csv

ANOMALY_DETECTOR=hybrid
ANOMALY_THRESHOLD=4.5
ROLLING_WINDOW=61
MIN_EVENT_LENGTH=3
MERGE_GAP=5
CONTAMINATION=0.01

# 预测与回测参数
FORECAST_HORIZON=30
FORECAST_LOOKBACK=120
FORECAST_HOLDOUT=30

# 可选：为 HTTP 服务设置访问密钥；留空表示本地开发不校验
INDUSTRIAL_API_KEY=
